# ----------------------------------------------------------------------------
# Videleum 运行环境变量示例
# 复制此文件为 .env 并按需调整参数: cp .env.example .env
# ----------------------------------------------------------------------------

# 媒体文件与下载存储路径（支持相对路径或宿主机绝对路径）
VIDELEUM_UPLOADS_DIR=./uploads

# 数据库与系统数据存储路径
VIDELEUM_BACKEND_DATA_DIR=./data

# 部署安全信任级别 (application | container | host)
VIDELEUM_ADMIN_TRUST_LEVEL=application

# 后端服务端口 (默认: 5551)
PORT=5551

# 前端 Web 访问端口 (默认: 5556)
FRONTEND_PORT=5556
